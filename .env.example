# DocuMind AI environment configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# --- Application ---
APP_NAME=DocuMind AI
DEBUG=false

# --- Security ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440

# --- Persistence ---
DATABASE_URL=./data/documind.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# --- Vector store ---
# Leave QDRANT_URL empty when using the embedded on-disk store.
QDRANT_URL=
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=documind_chunks
QDRANT_API_KEY=

# --- LLM inference (KIE API) ---
KIE_API_KEY=your_kie_api_key
OPENAI_BASE_URL=https://api.kie.ai/codex/v1
OPENAI_MODEL=gpt-5.6-terra
LLM_TIMEOUT_SECONDS=240

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- RAG tuning ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.08

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

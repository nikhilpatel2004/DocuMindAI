# Copy this file to .env.production and fill in the empty required values.
# .env.production is gitignored and must never be committed or baked into an image.

APP_NAME=DocuMind AI
DEBUG=false
HTTP_PORT=8080

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# Required. The public origin of the deployed frontend, e.g. https://documind.example.com
CORS_ORIGINS=https://your-domain.example

# Absolute container paths; everything under /app/data is persisted.
DATABASE_URL=/app/data/documind.db
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=20
QDRANT_LOCAL_PATH=/app/data/qdrant
QDRANT_COLLECTION=documind_chunks

# Required. Server-side only; never expose this in frontend code.
KIE_API_KEY=
OPENAI_BASE_URL=https://api.kie.ai/codex/v1
OPENAI_MODEL=gpt-5.6-terra
LLM_TIMEOUT_SECONDS=240

# Persist the Sentence Transformers download in the volume.
HF_HOME=/app/data/hf-cache
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.08
